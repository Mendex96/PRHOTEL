<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Página no encontrada</title>
    <style>
        body {
                font-family: 'Arial', sans-serif;
                margin-bottom: 0px;
                margin-right: 0px;
                margin-left: 0px;
                padding: 0;
                background-color: #f4f4f4;
                color: #333;
            }
            header {
                background-color: #094293;
                color: white;
                text-align: center;
                padding: 20px 0;
            }
            header h1 {
                font-size: 2.8em;
                margin: 0;
                font-weight: bold;
            }
            nav {
                display: flex;
                justify-content: center;
                gap: 20px;
                margin-top: 10px;
            }
            nav a {
                text-decoration: none;
                color: #ddd;
                font-size: 1.2em;
                padding: 5px 10px;
                transition: background-color 0.3s, color 0.3s;
            }
            nav a:hover {
                color: #fff;
                background-color: #555;
                border-radius: 5px;
            }
        .background {
            background: url('/images/hotel-lobby.webp') no-repeat center center fixed;
            position: relative;
            top: 0;
            width: 100%;
            height: calc(90vh); 
            margin-top: 20px; 
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            background-size: cover;
        }
        .error-code {
            font-size: 100px;
            color: #007BFF;
            margin: 0;
        }
        .error-message {
            font-size: 24px;
            margin: 10px 0;
            color: black;
        }
        .back-button {
            background-color: #007BFF;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
            text-decoration: none;
        }
        .back-button:hover {
            background-color: #0056b3;
        }
        footer {
            background-color: #333;
            color: #ddd;
            text-align: center;
            padding: 15px 0;
            font-size: 0.9em;
        }
        
    </style>
</head>
<body>
    <header id="main-header" style="position: fixed;top: 0;left: 0;width: 100%;z-index: 1000;padding-top: 0px;padding-bottom: 0px;">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; height: 40px; padding: 0 15px; transition: background-color 0.3s;">
            <a href="/" style="text-decoration: none; display: flex; align-items: center; height: 100%;">
                <img src="/images/logo.webp" alt="Logo del Hotel Paraíso Tropical" style="height: 100%; border-radius: 5px; size: 60px;">
            </a>
            <nav style="display: flex;gap: 10px;padding-right: 20px;align-items: center;margin-top: 0px;">
                <a href="/" >Inicio</a>
                <a href="/habitaciones">Habitaciones</a>
                <a href="/services">Servicios</a>
                <a href="/contacto">Contacto</a>
            </nav>
        </div>
      </header>
    
    <script>
      window.addEventListener("scroll", function () {
          const header = document.getElementById("main-header");
          const scrollY = window.scrollY;
    
          // Calcular un valor de color dinámico en base al desplazamiento
          const maxScroll = 500; // Máxima cantidad de desplazamiento que consideramos para el color
          let colorIntensity = Math.min(scrollY / maxScroll, 1); // Determina entre 0 y 1 según el scroll
    
          // Calcular los valores de RGB para la transición de #094293 (9, 66, 146) a #333 (51, 51, 51)
          let redColor = Math.floor(9 + (51 - 9) * colorIntensity); // De 9 a 51
          let greenColor = Math.floor(66 + (51 - 66) * colorIntensity); // De 66 a 51
          let blueColor = Math.floor(146 + (51 - 146) * colorIntensity); // De 146 a 51
    
          // Ajusta el color de fondo del header basado en el scroll
          header.style.backgroundColor = `rgb(${redColor}, ${greenColor}, ${blueColor})`; // Valor RGB dinámico
      });
    </script>
    <div class="background">
        <h1 class="error-code">404</h1>
        <p class="error-message">Lo sentimos, la página se ha tomado unas vacaciones.</p>
        <a href="/" class="back-button">Volver</a>
    </div>
    <footer>
        <p>&copy; 2024 Hotel Paraíso Tropical. Todos los derechos reservados.</p>
      </footer>
</body>
</html>


