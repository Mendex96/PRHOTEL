<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contacto - Hotel Luxor</title>
    <style>
        body {
           font-family: 'Arial', sans-serif;
           margin-bottom: 0px;
            margin-right: 0px;
            margin-left: 0px;
           padding: 0;
           background-color: #f4f4f4;
           color: #333;
           margin-top: 30px;

       }
       .background {
            position: relative;
            top: 0;
            width: 100%;
            height: calc(100vh); 
            margin-top: 20px; 
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            background-size: cover;
        }
       header {
           background-color: #094293;
           color: white;
           text-align: center;
           padding: 20px 0;
           margin-bottom: 20px;
       }
       header h1 {
           font-size: 2.8em;
           margin: 0;
           font-weight: bold;
       }
       nav {
           display: flex;
           justify-content: center;
           gap: 20px;
           margin-top: 10px;
       }
       nav a {
           text-decoration: none;
           color: #ddd;
           font-size: 1.2em;
           padding: 5px 10px;
           transition: background-color 0.3s, color 0.3s;
       }
       nav a:hover {
           color: #fff;
           background-color: #555;
           border-radius: 5px;
       }
       section.hero {
           background-image: url('/images/hotel-hero.webp');
           background-size: cover;
           background-position: center;
           height: 400px;
           display: flex;
           align-items: center;
           justify-content: center;
           color: white;
           text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
       }
       section.hero h2 {
           font-size: 2.5em;
           margin: 0;
       }
       section.features {
           display: flex;
           flex-wrap: wrap;
           gap: 20px;
           padding: 40px;
           justify-content: center;
           background-color: #fff;
       }
       .feature-card {
           background: #f9f9f9;
           border: 1px solid #ddd;
           border-radius: 8px;
           box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
           width: 280px;
           padding: 20px;
           text-align: center;
           transition: transform 0.3s, box-shadow 0.3s;
       }
       .feature-card:hover {
           transform: translateY(-5px);
           box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
       }
       .feature-card img {
           max-width: 100%;
           border-radius: 8px;
           margin-bottom: 15px;
       }
       .feature-card h3 {
           font-size: 1.5em;
           margin: 10px 0;
       }
       footer {
            background-color: #333;
            color: #ddd;
            text-align: center;
            padding: 15px 0;
            font-size: 0.9em;
        }
      
        h2{
            position: absolute;
            
            left: 50%;
            transform: translateX(-50%);
            font-size: 2em;
            font-weight: bold;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
        }

        .contact-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            padding: 20px;
        }

        .contact-form {
            flex: 1 1 45%;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-right: 20px;

        }

        .contact-form label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .contact-form input,
        .contact-form textarea {
            width: 95%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1em;
        }

        .contact-form button {
            padding: 10px 20px;
            background-color: #c0392b;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .contact-form button:hover {
            background-color: #e74c3c;
        }

        .map {
            flex: 1 1 45%;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .map iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
   </style>
</head>
<body>
    <header id="main-header" style="position: fixed;top: 0;left: 0;width: 100%;z-index: 1000;padding-top: 0px;padding-bottom: 0px;">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; height: 40px; padding: 0 15px; transition: background-color 0.3s;">
            <a href="/" style="text-decoration: none; display: flex; align-items: center; height: 100%;">
                <img src="/images/logo.webp" alt="Logo del Hotel Paraíso Tropical" style="height: 100%; border-radius: 5px; size: 60px;">
            </a>
            <a>Hotel Paraíso Tropical - Contacto</a>
            <nav style="display: flex;gap: 10px;padding-right: 20px;align-items: center;margin-top: 0px;">
                <a href="/" >Inicio</a>
                <a href="/habitaciones">Habitaciones</a>
                <a href="/services">Servicios</a>
                <a href="/contacto">Contacto</a>
            </nav>
        </div>
      </header>
      <script>
        window.addEventListener("scroll", function () {
            const header = document.getElementById("main-header");
            const scrollY = window.scrollY;
      
            // Calcular un valor de color dinámico en base al desplazamiento
            const maxScroll = 500; // Máxima cantidad de desplazamiento que consideramos para el color
            let colorIntensity = Math.min(scrollY / maxScroll, 1); // Determina entre 0 y 1 según el scroll
      
            // Calcular los valores de RGB para la transición de #094293 (9, 66, 146) a #333 (51, 51, 51)
            let redColor = Math.floor(9 + (51 - 9) * colorIntensity); // De 9 a 51
            let greenColor = Math.floor(66 + (51 - 66) * colorIntensity); // De 66 a 51
            let blueColor = Math.floor(146 + (51 - 146) * colorIntensity); // De 146 a 51
      
            // Ajusta el color de fondo del header basado en el scroll
            header.style.backgroundColor = `rgb(${redColor}, ${greenColor}, ${blueColor})`; // Valor RGB dinámico
        });
      </script>
    
<div class="contact-container">
    <div class="contact-form">
        <form action="/contacto/enviar" method="post">
            <div class="form-group"> 
                <label for="name">Nombre:</label>
                <input type="text" id="name" name="name" required>
            </div>
           
            <div class="form-group"> 
                <label for="email">Correo Electrónico:</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group"> 
                <label for="subject">Asunto:</label>
                <input type="text" id="subject" name="subject" required>
            </div>

            <div class="form-group"> 
                <label for="message">Mensaje:</label>
                <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <button>Enviar</button>
        </form>
    </div>
    <div class="map">
        <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3153.835434509288!2d-122.41941528467712!3d37.77492977975959!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80858064fbe24c2b%3A0x4b6d567438c076d!2sHotel%20Luxor!5e0!3m2!1sen!2sus!4v1697060608151!5m2!1sen!2sus" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>
</div>
<footer>
    <p>&copy; 2024 Hotel Paraíso Tropical. Todos los derechos reservados.</p>
  </footer>

</body>
</html>